{
  "name": "aofahub-chat",
  "account_id": "faa48c4594352d235803143377d82d1f",
  "compatibility_date": "2026-11-19",
  "workers_dev": true,
  "routes": [{ "pattern": "chat.aofahub.dev", "custom_domain": true }],
  // Workers Builds 的部署命令是 wrangler deploy，不会单独跑 pnpm build。
  // 这里让 Wrangler 先构建，再检查 assets.directory。
  "build": {
    "command": "pnpm run build",
  },
  // 有了 main，Worker 才有运行代码，Dashboard 才能添加 Secrets。
  "main": "worker/index.ts",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
